module FPGA_Master (
    input  wire        clk,      // 50 MHz
    input  wire        rst_n,    // Active Low
    input  wire [15:0] data_in,  // 16-bit data to send (2 bytes)
    input  wire        start,    // Trigger signal to start transmission
    output reg         sck,      // SPI Clock
    output reg         mosi,     // SPI Data Out
    output reg         cs,       // SPI Chip Select
    output reg         done      // Transmission finished flag
);

    // SPI SCK Divider (e.g., 100 kHz)
    reg [8:0] clk_div;
    reg       sck_reg;
    
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            clk_div <= 0;
            sck_reg <= 0;
        end else begin
            if (clk_div == 249) begin
                clk_div <= 0;
                sck_reg <= ~sck_reg;
            end else begin
                clk_div <= clk_div + 1;
            end
        end
    end

    reg sck_reg_d;
    always @(posedge clk) sck_reg_d <= sck_reg;
    wire sck_falling = (sck_reg == 0 && sck_reg_d == 1);

    // State Machine
    localparam ST_IDLE = 2'd0,
               ST_SEND = 2'd1,
               ST_DONE = 2'd2;

    reg [1:0]  state;
    reg [4:0]  bit_cnt;
    reg [15:0] shift_reg;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state     <= ST_IDLE;
            cs        <= 1'b1;
            mosi      <= 1'b0;
            sck       <= 1'b0;
            bit_cnt   <= 0;
            shift_reg <= 0;
            done      <= 1'b0;
        end else begin
            case (state)
                ST_IDLE: begin
                    done <= 1'b0;
                    cs   <= 1'b1;
                    sck  <= 1'b0;
                    if (start) begin
                        shift_reg <= data_in;
                        bit_cnt   <= 15;
                        cs        <= 1'b0;
                        state     <= ST_SEND;
                    end
                end

                ST_SEND: begin
                    sck  <= sck_reg;
                    mosi <= shift_reg[bit_cnt];
                    
                    if (sck_falling) begin
                        if (bit_cnt == 0) begin
                            state <= ST_DONE;
                        end else begin
                            bit_cnt <= bit_cnt - 1;
                        end
                    end
                end

                ST_DONE: begin
                    sck <= sck_reg;
                    if (sck_falling) begin
                        cs    <= 1'b1;
                        mosi  <= 1'b0;
                        done  <= 1'b1;
                        state <= ST_IDLE;
                    end
                end
            endcase
        end
    end

endmodule
